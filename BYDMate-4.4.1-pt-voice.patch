+package com.bydmate.app.voice
+
+/** Localizes status speech without changing the underlying command or its detailed UI result. */
+internal object PortugueseVoicePrompts {
+    fun outcome(text: String): String = when (text) {
+        "Готово" -> "Pronto."
+        "Не получилось" -> "Não foi possível executar a ação."
+        "Не понял" -> "Não entendi. Pode repetir, por favor?"
+        "Ошибка" -> "Ocorreu um erro. Consulte a mensagem na tela."
+        "Выполняю" -> "Executando."
+        else -> if (text.any { it in '\u0400'..'\u052f' }) {
+            // Untranslated local messages are not a success signal. Keep details on screen.
+            "Consulte os detalhes da resposta na tela."
+        } else text
+    }
+}
